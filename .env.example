# Google Drive API Key (required for folder access)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project and enable "Google Drive API"
# 3. Create an API key under Credentials
GOOGLE_DRIVE_API_KEY=your_api_key_here

# Dropbox App Access Token (required for public shared folder links)
# NOT user OAuth — this is a server-side app token generated in the Dropbox App Console.
# 1. Go to https://www.dropbox.com/developers/apps
# 2. Create an app (Scoped access, Full Dropbox or App folder)
# 3. Enable permissions: sharing.read, files.metadata.read, files.content.read
# 4. Generate an access token under Settings
# 5. Copy this file to .env: cp .env.example .env
DROPBOX_ACCESS_TOKEN=your_dropbox_token_here

# Microsoft Graph for OneDrive / SharePoint public shared links
# NOT user OAuth — server-side app credentials (like Dropbox token).
# The app redeems public sharing links; users never log in with Microsoft.
#
# Option A — static access token (simplest for dev):
# MICROSOFT_GRAPH_ACCESS_TOKEN=your_graph_token_here
#
# Option B — client credentials (auto-refresh, recommended for prod):
# 1. Register an app at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# 2. Add application permission: Microsoft Graph → Files.Read.All
# 3. Grant admin consent for your tenant
# 4. Create a client secret under Certificates & secrets
MICROSOFT_GRAPH_CLIENT_ID=your_azure_app_client_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_GRAPH_TENANT_ID=your_azure_tenant_id

# WeTransfer (optional debug logs; no API key required)
# PHOTOFIND_WETRANSFER_DEBUG=1

# HEIC conversion debug logs (enabled by default; set to 0 to silence)
# PHOTOFIND_HEIC_DEBUG=1

# AWS Rekognition — validación de referencia y búsqueda facial (Fase 1+)
# 1. Creá un usuario IAM con permisos rekognition:DetectFaces, CompareFaces,
#    CreateCollection, IndexFaces, SearchFacesByImage, DescribeCollection, DeleteCollection
# 2. Región fija: us-east-1 (ver server/recognize/config.ts)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Opcional: perfil local de AWS CLI en lugar de claves explícitas
# AWS_PROFILE=default
# PHOTOFIND_QUALITY_DEBUG=1  — log de métricas de calidad en consola del servidor

