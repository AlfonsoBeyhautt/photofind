{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/debug/health.ts": {
      "maxDuration": 15,
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/api/debug/health", "destination": "/api/debug/health" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
